<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="TaskManagement.Mobile.Views.TaskDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Task Detail">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="{Binding SelectedItem.Title}"
                FontSize="24"
                FontAttributes="Bold" />

            <Label
                Text="{Binding SelectedItem.Description}"
                FontSize="16" />


            <Label
                Text="{Binding SelectedItem.Priority, StringFormat='Priority: {0}'}"
                FontSize="16" />


            <Label
                Text="{Binding SelectedItem.Status, StringFormat='Status: {0}'}"
                FontSize="16" />


            <Label
                Text="{Binding SelectedItem.DueDate, StringFormat='Creation Date: {0:dd/MM/yyyy HH:mm}'}"
                FontSize="16" />
            
            <Button
                Margin="0,20,0,0"
                Text="Edit"
                Command="{Binding EditCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>